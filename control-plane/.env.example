# Control plane — see docs/self-hosting.md
DATABASE_URL=postgres://localhost:5432/fleetos_dev
REDIS_URL=redis://localhost:6379
JWT_SECRET=change-me-in-production
SECRETS_MASTER_KEY=            # 32 bytes, base64. Generate: openssl rand -base64 32
HEARTBEAT_INTERVAL_SEC=5
HEARTBEAT_MISS_THRESHOLD=3
REGISTRY_URL=              # e.g. localhost:5001 or ghcr.io/you
REGISTRY_CREDENTIALS=      # push/pull auth, if the registry needs it
BUILDX_BUILDER=            # named buildx builder; blank uses the default
BUILD_WORKDIR=/tmp/fleet-os/builds
BUILD_TIMEOUT_MS=1200000
PORT=8080
LOG_LEVEL=info
