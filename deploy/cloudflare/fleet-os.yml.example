# Cloudflare Tunnel config for Fleet OS.
#
# Kept as its own file so it never touches ~/.cloudflared/config.yml, which
# already routes other projects. Run it with:
#
#   cloudflared tunnel --config deploy/cloudflare/fleet-os.yml run
#
# Three hostnames, three jobs:
#   fleet.<zone>    the dashboard (nginx, which also proxies /api)
#   api.fleet.<zone> the control-plane API directly — for the CLI and agents
#   *.fleet.<zone>  every deployed service, via the ingress edge
#
# The wildcard is what makes a deployed service reachable at the hostname the
# scheduler assigned it, and it is why INGRESS_ZONE must match this zone.

tunnel: REPLACE_WITH_TUNNEL_ID
credentials-file: /Users/REPLACE_ME/.cloudflared/REPLACE_WITH_TUNNEL_ID.json

# Cloudflare terminates TLS; these are plain HTTP on the loopback.
ingress:
  - hostname: fleet.plastikworld.xyz
    service: http://localhost:8082

  - hostname: api.fleet.plastikworld.xyz
    service: http://localhost:8080

  # Every deployed service. The edge resolves the Host header to whichever
  # node is running that service right now.
  - hostname: "*.fleet.plastikworld.xyz"
    service: http://localhost:8081
    originRequest:
      # QUIC is faster where it works and unreliable on networks that treat
      # long-lived UDP as suspicious, which describes a lot of home ISPs.
      # This is the lesson the tech doc records from plastikworld.xyz itself.
      http2Origin: true

  - service: http_status:404
