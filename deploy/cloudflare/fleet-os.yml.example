# Cloudflare Tunnel config for Fleet OS.
#
# Its own file, never ~/.cloudflared/config.yml, which routes other projects
# and would be clobbered.
#
#   cloudflared tunnel --config deploy/cloudflare/fleet-os.yml run
#
# Rules match in order and the first wins, so every specific hostname must
# come before the wildcard or the wildcard swallows them all.
#
# Every hostname here is ONE level below the apex. Cloudflare's free Universal
# SSL covers the apex and one level; anything deeper has no certificate and
# fails TLS in the browser with nothing useful in the error.

tunnel: REPLACE_WITH_TUNNEL_ID
credentials-file: /etc/cloudflared/credentials.json

# Origins are compose service names, not localhost: the tunnel runs as a
# container beside them, so it reaches them on the compose network and the
# public path needs no published host port at all.

# Keep reconnecting. cloudflared gives up after a few attempts by default and
# exits, which takes the site down silently — the container restart policy is
# the backstop, this is the first line of defence.
retries: 20
grace-period: 30s

# Edge transport, cloudflared -> Cloudflare. A different hop from
# originRequest below, which is cloudflared -> your local server.
#
# QUIC is the default and faster where it works. It is also UDP/443, which
# many home ISPs silently drop — the symptom is "failed to dial to edge with
# quic: timeout" and a tunnel that never connects. context.txt §3 records
# exactly this from this domain, so http2 is the default rather than
# something to rediscover.
protocol: http2

originRequest:
  http2Origin: true
  connectTimeout: 30s

ingress:
  # The marketing site.
  - hostname: fleet.REPLACE_ZONE
    service: http://www:80

  # The dashboard. Its nginx also proxies /api, so the browser stays
  # same-origin and never meets CORS.
  - hostname: fleetapp.REPLACE_ZONE
    service: http://dashboard:80

  # The API directly, for the CLI and for agents.
  - hostname: fleetapi.REPLACE_ZONE
    service: http://control-plane:8080

  # Every deployed service. Managed hostnames are a single label
  # (web-homelab-7efe4c) precisely so this one wildcard covers them all.
  #
  # Explicit records on the zone still win over a wildcard, so anything else
  # already on plastikworld.xyz keeps working.
  #
  # The image registry, so nodes that are not on this LAN can pull. Above the
  # wildcard on purpose: cloudflared matches these top to bottom, and
  # "*.REPLACE_ZONE" would otherwise swallow image pulls into the ingress edge.
  #
  # Cloudflare terminates TLS, so a node reaches the registry over https and
  # needs no insecure-registries entry — which is the whole reason this beats
  # publishing a port on the LAN. It also means the registry is reachable from
  # the internet, so run deploy/setup-registry-auth.sh first: registry:2 has no
  # access control of its own, and without credentials anyone who finds the
  # address can pull every image you have built and push whatever they like.
  - hostname: fleetregistry.REPLACE_ZONE
    service: http://registry:5000
    originRequest:
      # Image layers are large; a slow uplink must not time out a push.
      connectTimeout: 60s

  # SSH, carried over the tunnel instead of over port 22.
  #
  # Campus and corporate networks routinely block outbound 22 by port number,
  # and the stricter ones refuse every connection to a bare IP address, which
  # leaves no way in at all - including the Lightsail browser console, which is
  # only useful if sshd is already running. This route is HTTPS to a hostname,
  # so it survives both. It must sit above the wildcard: rules match in order
  # and "*.REPLACE_ZONE" would otherwise answer it.
  #
  # host.docker.internal because cloudflared runs in a container and the sshd
  # it has to reach does not; compose maps that name to the host gateway.
  - hostname: fleetssh.REPLACE_ZONE
    service: ssh://host.docker.internal:22

  - hostname: "*.REPLACE_ZONE"
    service: http://control-plane:8081

  - service: http_status:404
