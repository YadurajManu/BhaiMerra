# Copy to .env and fill in. Generate the two secrets with:
#   openssl rand -hex 32      -> JWT_SECRET
#   openssl rand -base64 32   -> SECRETS_MASTER_KEY

POSTGRES_PASSWORD=
JWT_SECRET=
# Lose this and every stored secret is unrecoverable. Back it up separately.
SECRETS_MASTER_KEY=

# Optional: enables signature verification on git webhooks.
WEBHOOK_SECRET=

# Must be reachable FROM your agent machines, not from this host.
# On a LAN that means your machine's IP, not localhost.
#   REGISTRY_URL=192.168.1.20:5001
REGISTRY_URL=

# Managed hostnames become <service>.<fleet>-<id>.<zone>
INGRESS_ZONE=fleetos.app

API_PORT=8080
INGRESS_PORT=8081
REGISTRY_PORT=5001
LOG_LEVEL=info
