# Copy to .env and fill in. Generate the two secrets with:
#   openssl rand -hex 32      -> JWT_SECRET
#   openssl rand -base64 32   -> SECRETS_MASTER_KEY

POSTGRES_PASSWORD=
JWT_SECRET=
# Lose this and every stored secret is unrecoverable. Back it up separately.
SECRETS_MASTER_KEY=

# Optional: enables signature verification on git webhooks.
WEBHOOK_SECRET=

# Optional GitHub App integration. Create an app with repository Contents:
# Read-only and Webhooks: Read & write, install it on the repositories Fleet
# may deploy, then point the webhook at the URL shown in Dashboard → Settings.
GITHUB_APP_ID=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
# Host path to the GitHub App PEM file; Compose mounts it read-only into the
# control-plane container as /run/secrets/github-app.pem.
GITHUB_APP_PRIVATE_KEY=

# Must be reachable FROM your agent machines, not from this host.
# On a LAN that means your machine's IP, not localhost:
#   REGISTRY_URL=192.168.1.20:5001
#
# A node that is not on this LAN cannot reach that at all. Route the registry
# through the Cloudflare tunnel instead (see cloudflare/fleet-os.yml.example)
# and name it here; Cloudflare terminates TLS, so no node needs an
# insecure-registries entry:
#   REGISTRY_URL=fleetregistry.example.com
REGISTRY_URL=

# "username:password" for a registry that requires them. The control plane
# signs in with it to push, and passes it to agents so they can pull.
#
# Required once the registry is reachable from outside your LAN: registry:2 has
# no access control of its own, so without this anyone who finds the address
# can pull every image you have built and push whatever they like for your
# nodes to run. Generate with deploy/setup-registry-auth.sh.
REGISTRY_CREDENTIALS=

# Managed hostnames become <service>.<fleet>-<id>.<zone>
INGRESS_ZONE=fleetos.app

API_PORT=8080
# Public URL the CLI and agents use directly (not the dashboard URL). Defaults
# to https://fleetapi.<INGRESS_ZONE>; only set it to override that convention.
PUBLIC_API_URL=https://fleetapi.example.com
INGRESS_PORT=8081
REGISTRY_PORT=5001
DASHBOARD_PORT=8082
LOG_LEVEL=info

WWW_PORT=8083
# Where the dashboard is reachable; baked into the marketing site's CTAs.
APP_URL=https://app.fleet.plastikworld.xyz

# Cloudflare cert authorised for this zone (see docs/self-hosting.md).
ORIGINCERT=

# Credentials JSON for the tunnel, mounted into the cloudflared container.
TUNNEL_CREDENTIALS=
